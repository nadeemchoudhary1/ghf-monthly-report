# Server Port (Render provides PORT automatically)
PORT=5000
NODE_ENV=development

# MongoDB Atlas M0 Free Tier Connection String (never expose to frontend)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ghf_portal?retryWrites=true&w=majority

# Frontend public URL (used for CORS and Admin links in notification emails)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting settings (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# JWT Authentication Secret (generate a strong random 32+ char secret in production)
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials (used ONLY by `npm run seed:admin` or first-run setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ghf.org
ADMIN_PASSWORD=ChangeMeStrongPass123!
ADMIN_NAME=GHF Administrator

# Resend Email Notifications (Free Tier: 3,000/month, 100/day)
RESEND_API_KEY=
EMAIL_FROM=GHF Portal <noreply@yourdomain.com>
GHF_ADMIN_EMAIL=admin@yourdomain.com
GHF_CONTACT_INFO=Guided Humanity Foundation (help@ghf.org)

# Google Sheets Integration (Service Account with Editor access to sheet)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
